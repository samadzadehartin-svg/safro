{
  "name": "safro-next-nest",
  "version": "9.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c auto \"next dev\" \"tsx watch server/src/main.ts\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server/src/main.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "next build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "concurrently -n web,api -c auto \"next start\" \"node server/dist/main.js\"",
    "start:web": "next start",
    "start:api": "node server/dist/main.js",
    "lint": "eslint . --ignore-pattern server/dist --ignore-pattern .next"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "daisyui": "^5.7.16",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "^9.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Safro Next + Nest"
}
